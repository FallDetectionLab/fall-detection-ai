[Unit]
Description=Security Camera Flask Application
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/app
Environment=PATH=/opt/app/venv/bin
Environment=FLASK_ENV=production
Environment=UPLOAD_FOLDER=/opt/app/incident_videos
Environment=DATABASE_PATH=/opt/app/incidents.db
Environment=SECRET_KEY=your-production-secret-key-change-this
ExecStart=/opt/app/venv/bin/gunicorn --config gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target