import sys
import io
import os
import tempfile
import numpy as np
import torch
import cv2
from PIL import Image

# YOLOv5 모듈을 안전하게 import하기 위한 경로 조정
def safe_import_yolov5():
    """YOLOv5 모듈을 안전하게 import"""
    yolov5_path = os.getenv("YOLOV5_REPO", "/srv/flaskapp/yolov5")
    
    try:
        # YOLOv5 경로를 맨 앞에 추가하여 우선순위 높임
        if yolov5_path not in sys.path:
            sys.path.insert(0, yolov5_path)
        
        # YOLOv5의 utils 모듈을 직접 import
        from utils.general import non_max_suppression
        print(f"✓ Successfully imported YOLOv5 utils from {yolov5_path}")
        return non_max_suppression
    
    except ImportError as e:
        print(f"✗ YOLOv5 import 실패: {e}")
        print(f"Tried path: {yolov5_path}")
        return None

# 전역에서 한 번만 import 시도
_nms_function = None

def get_nms_function():
    """NMS 함수를 지연 로드"""
    global _nms_function
    if _nms_function is None:
        _nms_function = safe_import_yolov5()
    return _nms_function

def infer_with_v5_model(model, image_bytes: bytes, conf_thres=0.25, iou_thres=0.45,
                        class_names=None, imgsz=640, device="cpu"):
    """YOLOv5 안전 추론: letterbox → BCHW → model → NMS → 원본좌표 복원"""
    
    def _letterbox_safe(img: np.ndarray, new_shape=(640, 640), color=(114, 114, 114)):
        if isinstance(new_shape, int):
            new_shape = (new_shape, new_shape)
        h, w = img.shape[:2]
        r = min(new_shape[0] / h, new_shape[1] / w)
        new_unpad = (int(round(w * r)), int(round(h * r)))
        dw = new_shape[1] - new_unpad[0]
        dh = new_shape[0] - new_unpad[1]
        dw /= 2.0
        dh /= 2.0
        
        if (new_unpad[0], new_unpad[1]) != (w, h):
            img = cv2.resize(img, new_unpad, interpolation=cv2.INTER_LINEAR)
        
        top, bottom = int(round(dh - 0.1)), int(round(dh + 0.1))
        left, right = int(round(dw - 0.1)), int(round(dw + 0.1))
        img = cv2.copyMakeBorder(img, top, bottom, left, right, cv2.BORDER_CONSTANT, value=color)
        
        return img, r, (left, top)

    # 이미지 전처리
    pil = Image.open(io.BytesIO(image_bytes)).convert("RGB")
    orig_h, orig_w = pil.height, pil.width
    arr = np.array(pil)  # HWC

    # stride 처리
    try:
        stride_attr = getattr(model, "stride", 32)
        stride = int(max(stride_attr)) if isinstance(stride_attr, (list, tuple)) else int(stride_attr)
    except Exception:
        stride = 32
    
    if imgsz % stride:
        imgsz = int(round(imgsz / stride) * stride)

    # Letterbox 적용
    lb, ratio, pad = _letterbox_safe(arr, new_shape=(imgsz, imgsz))
    im = lb.transpose((2, 0, 1))  # HWC -> CHW
    im = np.ascontiguousarray(im)
    im = torch.from_numpy(im).to(device).float() / 255.0
    
    if im.ndim == 3:
        im = im.unsqueeze(0)  # CHW -> BCHW

    # 모델 추론
    with torch.no_grad():
        # YOLOWrapper인 경우 실제 추론은 건너뛰고 더미 결과 반환
        if hasattr(model, 'state_dict_data'):
            print("Warning: Using YOLOWrapper - returning dummy results")
            # 더미 결과 (실제 모델 없이 테스트용)
            dummy_result = torch.zeros(1, 25200, 6)  # [batch, anchors, [x,y,w,h,conf,cls]]
            pred = dummy_result
        else:
            pred = model(im, augment=False, visualize=False)
            if isinstance(pred, (list, tuple)):
                pred = pred[0]

        # NMS 적용 (안전한 방식)
        nms_func = get_nms_function()
        if nms_func is not None:
            try:
                dets_list = nms_func(pred, conf_thres=conf_thres, iou_thres=iou_thres)
            except Exception as e:
                print(f"NMS 실행 실패: {e}, 원본 결과 사용")
                dets_list = [pred] if not isinstance(pred, (list, tuple)) else pred
        else:
            print("Warning: NMS function not available, using raw predictions")
            dets_list = [pred] if not isinstance(pred, (list, tuple)) else pred

    # 결과 처리
    dets = dets_list[0] if isinstance(dets_list, (list, tuple)) else dets_list
    results = []
    
    if dets is not None and len(dets):
        dets_np = dets.detach().cpu().numpy()
        
        for row in dets_np:
            if row.shape[0] < 6:
                continue
            
            x1, y1, x2, y2, conf, cls = row[:6]

            def _to_float(x): 
                return float(np.asarray(x).reshape(-1)[0])
            def _to_int(x):   
                return int(np.asarray(x).reshape(-1)[0])

            x1 = _to_float(x1); y1 = _to_float(y1)
            x2 = _to_float(x2); y2 = _to_float(y2)
            conf = _to_float(conf); cls_idx = _to_int(cls)

            # 좌표를 원본 이미지 크기로 복원
            pad_x, pad_y = pad
            x1 = (x1 - pad_x) / ratio; y1 = (y1 - pad_y) / ratio
            x2 = (x2 - pad_x) / ratio; y2 = (y2 - pad_y) / ratio

            # 경계값 확인
            x1 = max(0.0, min(float(orig_w), x1))
            y1 = max(0.0, min(float(orig_h), y1))
            x2 = max(0.0, min(float(orig_w), x2))
            y2 = max(0.0, min(float(orig_h), y2))

            # 클래스명 처리
            if isinstance(class_names, dict):
                label = class_names.get(cls_idx, str(cls_idx))
            elif isinstance(class_names, (list, tuple)) and 0 <= cls_idx < len(class_names):
                label = class_names[cls_idx]
            else:
                label = str(cls_idx)

            results.append({
                "cls": cls_idx, 
                "label": label, 
                "conf": conf, 
                "xyxy": [x1, y1, x2, y2]
            })

    return results


def infer_with_v8_model(model, image_bytes: bytes, class_names=None, imgsz=640, device="cpu"):
    """YOLOv8 추론: 임시파일 기반 predict"""
    with tempfile.NamedTemporaryFile(delete=False, suffix=".jpg") as tmp:
        tmp.write(image_bytes)
        path = tmp.name
    
    try:
        results = model.predict(source=path, conf=0.25, iou=0.45, device=device, imgsz=imgsz, verbose=False)
        dets = []
        
        for r in results:
            for box in r.boxes:
                cls_idx = int(np.asarray(box.cls[0]).reshape(-1)[0])
                conf = float(np.asarray(box.conf[0]).reshape(-1)[0])
                xyxy = [float(x) for x in box.xyxy[0].tolist()]
                
                if isinstance(class_names, dict):
                    label = class_names.get(cls_idx, str(cls_idx))
                elif isinstance(class_names, (list, tuple)) and 0 <= cls_idx < len(class_names):
                    label = class_names[cls_idx]
                else:
                    label = str(cls_idx)
                
                dets.append({
                    "cls": cls_idx, 
                    "label": label, 
                    "conf": conf, 
                    "xyxy": xyxy
                })
        
        return dets
    
    finally:
        try: 
            os.remove(path)
        except Exception: 
            pass
