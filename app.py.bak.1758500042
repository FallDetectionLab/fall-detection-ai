# --- S3 설정 (버킷명은 순수 문자열이어야 함)
def normalize_bucket(b: str | None) -> str | None:
    if not b:
        return b
    b = b.strip()
    if b.startswith(("http://", "https://")):
        host = urlparse(b).netloc
        return host.split(".")[0]  # 첫 라벨을 버킷명으로
    return b

S3_BUCKET = normalize_bucket(os.getenv("S3_BUCKET", "safefall2"))
S3_REGION = os.getenv("AWS_REGION", "ap-northeast-2")

# ⚠️ IAM Role을 쓰려면 IMDS 접근이 필요합니다.
#    이전 코드에서 'true'로 강제 비활성화되어 있었던 부분을 끕니다.
# os.environ.setdefault("AWS_EC2_METADATA_DISABLED", "true")
os.environ["AWS_EC2_METADATA_DISABLED"] = os.getenv("AWS_EC2_METADATA_DISABLED", "false")

BOTO_CFG = BotoCfg(
    signature_version="s3v4",
    retries={"max_attempts": 2, "mode": "standard"},
    connect_timeout=2,
    read_timeout=3,
)
_s3 = boto3.client("s3", region_name=S3_REGION, config=BOTO_CFG)

# -----------------------------
# 1) DB 설정
# -----------------------------
app.config["SQLALCHEMY_DATABASE_URI"] = "sqlite:///safefall.db"
app.config["SQLALCHEMY_TRACK_MODIFICATIONS"] = False
db = SQLAlchemy(app)

class Event(db.Model):
    __tablename__ = "events"
    id = db.Column(db.Integer, primary_key=True, autoincrement=True)
    device_id = db.Column(db.String(64), nullable=False)
    t_event = db.Column(db.DateTime, default=datetime.utcnow, index=True)
    path = db.Column(db.String(512))   # 저장된 파일 경로 또는 S3 key
    type = db.Column(db.String(16), default="normal")  # normal/frame/fall 등
    is_checked = db.Column(db.Boolean, default=False)

class User(db.Model):
    __tablename__ = "users"
    id = db.Column(db.Integer, primary_key=True, autoincrement=True)
    username = db.Column(db.String(50), unique=True, nullable=False)
    password = db.Column(db.String(100), nullable=False)  # 실제로는 해시 사용 권장
    created_at = db.Column(db.DateTime, default=datetime.utcnow)

with app.app_context():
    db.create_all()
    # 초기 더미 유저
    if User.query.count() == 0:
        for u, p in [("네이버","12345678!"),("구글","12345678!"),("카카오","12345678!"),("dumydata","12345678!")]:
            db.session.add(User(username=u, password=p))
        db.session.commit()

# -----------------------------
# 2) 유틸
# -----------------------------
def authed(req) -> bool:
    return req.headers.get("Authorization", "") == AUTH

def utc_iso_now() -> str:
    return datetime.utcnow().isoformat() + "Z"

def paginate_query(query, page=1, limit=10):
    total = query.count()
    items = query.offset((page - 1) * limit).limit(limit).all()
    return {
        "data": items,
        "pagination": {
            "total": total,
            "page": page,
            "limit": limit,
            "total_pages": (total + limit - 1) // limit,
            "has_next": page * limit < total,
            "has_prev": page > 1
        }
    }

def build_media_url(path: str | None) -> str | None:
    """로컬 파일이 있으면 /api 경로, 아니면 S3 퍼블릭 URL로 반환"""
    if not path:
        return None
    local_full = os.path.join(MEDIA_ROOT, path)
    if os.path.exists(local_full):
        return f"/api/v1/media/{path}"
    return f"https://{S3_BUCKET}.s3.{S3_REGION}.amazonaws.com/{path}"

# === YOLOv5 설정 ===
YOLOV5_WEIGHTS = os.getenv("MODEL_PATH", "/srv/flaskapp/best.pt")  # wget으로 받아둔 best.pt 경로
YOLOV5_REPO    = os.getenv("YOLOV5_REPO", "/srv/flaskapp/yolov5")  # 로컬 yolov5 폴더 있으면 우선 사용
YOLOV5_IMG_SZ  = int(os.getenv("IMG_SIZE", "640"))
YOLOV5_CONF    = float(os.getenv("CONF_THRES", "0.25"))

_yolo5_cache = {"model": None, "names": None}

def load_yolov5():
    """
    YOLOv5 모델 lazy-load + 캐시.
    - /srv/flaskapp/yolov5 존재하면 source='local'
    - 없으면 source='github'
    """
    import sys, os, torch

    if 'torch' not in globals() or torch is None:
        return None, None, "torch_not_installed"

    if _yolo5_cache["model"] is not None:
        return _yolo5_cache["model"], _yolo5_cache["names"], None

    if not os.path.exists(YOLOV5_WEIGHTS):
        return None, None, f"weights_not_found:{YOLOV5_WEIGHTS}"

    try:
        # YOLOv5 repo를 sys.path에 등록
        sys.path.insert(0, YOLOV5_REPO)

        # PyTorch 2.6+ 에서 안전 로드 허용
        from torch.serialization import add_safe_globals
        from models.yolo import DetectionModel
	from models.common import Conv, Bottleneck, C3, SPPF, Concat, Focus, BottleneckCSP, C2f
        from torch.nn.modules.container import Sequential
        add_safe_globals([DetectionModel, Conv, Bottleneck, C3, SPPF, Concat, Focus, BottleneckCSP, C2f])

        # Torch cache 디렉토리 지정
        torch.hub.set_dir(os.environ.get("TORCH_HOME", "/srv/flaskapp/.cache/torch"))

        # 모델 로드
        if os.path.isdir(YOLOV5_REPO):
            model = torch.hub.load(
                YOLOV5_REPO if os.path.isdir(YOLOV5_REPO) else "ultralytics/yolov5",
                "custom",
                path=YOLOV5_WEIGHTS,
                source="local" if os.path.isdir(YOLOV5_REPO) else "github",
                force_reload=True,   # 캐시만 갱신할 때 True
                trust_repo=True
            )
        else:
            model = torch.hub.load(
                "ultralytics/yolov5",
                "custom",
                path=YOLOV5_WEIGHTS,
                source="github",
                force_reload=False,
                trust_repo=True
            )

        # 클래스 이름 가져오기
        names = model.names if hasattr(model, "names") else []
        _yolo5_cache["model"], _yolo5_cache["names"] = model, names
        return model, names, None

    except Exception as e:
        return None, None, f"load_error:{e}"

def _image_from_request(req_json):
    """
    입력 이미지를 PIL.Image로:
      - multipart/form-data: field 'image'
      - application/json: {'s3_key': '...'} 또는 {'s3_url': 'https://...'}
    """
    # 업로드 파일
    if "image" in request.files:
        f = request.files["image"]
        try:
            return Image.open(io.BytesIO(f.read())).convert("RGB"), None
        except Exception as e:
            return None, f"invalid image file: {e}"

    # JSON: S3 key / URL
    if req_json:
        k = req_json.get("s3_key")
        if k:
            try:
                obj = _s3.get_object(Bucket=S3_BUCKET, Key=k)
                data = obj["Body"].read()
                return Image.open(io.BytesIO(data)).convert("RGB"), None
            except Exception as e:
                return None, f"failed to read s3://{S3_BUCKET}/{k}: {e}"

        u = req_json.get("s3_url")
        if u:
            try:
                with urllib.request.urlopen(u, timeout=5) as r:
                    data = r.read()
                return Image.open(io.BytesIO(data)).convert("RGB"), None
            except Exception as e:
                return None, f"failed to fetch url: {e}"

    return None, "no image provided (multipart 'image' OR json 's3_key'/'s3_url')"


