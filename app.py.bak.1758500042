# === YOLOv5 헬스 ===
@api.get("/detect/health")
def detect_health_v5():
    try:
        torch_ok = ('torch' in globals()) and (globals().get('torch') is not None)
        model, names, err = load_yolov5()

        # torch 자체 import 실패면 그 이유를 우선 표기
        if not torch_ok and (globals().get('_TORCH_IMPORT_ERR')):
            err = f"torch_import_error: {globals().get('_TORCH_IMPORT_ERR')}"

        payload = {
            "ok": bool(model is not None and err is None),
            "torch_ok": bool(torch_ok),
            "model_path": YOLOV5_WEIGHTS if 'YOLOV5_WEIGHTS' in globals() else None,
            "repo": (YOLOV5_REPO if ('YOLOV5_REPO' in globals() and os.path.isdir(YOLOV5_REPO)) else "github(hub)"),
            "has_names": bool(names),
            "conf": YOLOV5_CONF if 'YOLOV5_CONF' in globals() else None,
            "img_size": YOLOV5_IMG_SZ if 'YOLOV5_IMG_SZ' in globals() else None,
            "err": (str(err) if err else None),
            # 디버깅 보조 정보
            "py": sys.version.split()[0],
            "exe": sys.executable,
        }
        return jsonify(payload), (200 if payload["ok"] else 503)

    except Exception as e:
        return jsonify({"ok": False, "error": f"health_failed:{str(e)}"}), 500

# === YOLOv5 감지 (기존과 충돌 피하려고 endpoint 이름 지정)
@api.post("/detect", endpoint="detect_v5")
def detect_v5():
    if not authed(request):
        return {"code": "UNAUTHORIZED", "message": "invalid token"}, 401

    model, names, err = load_yolov5()
    if err or model is None:
        return {"ok": False, "error": err or "model_not_loaded"}, 500

    req_json = request.get_json(silent=True) if request.is_json else None
    img, err2 = _image_from_request(req_json)
    if err2:
        return {"ok": False, "error": err2}, 400

    w, h = img.size
    t0 = time.time()

    try:
        np_img = np.array(img)  # RGB
        results = model(np_img, size=YOLOV5_IMG_SZ)  # 결과: results.xyxy[0] → [x1,y1,x2,y2,conf,cls]
        dets = []
        for *xyxy, conf, cls in results.xyxy[0].tolist():
            x1, y1, x2, y2 = [float(round(v, 2)) for v in xyxy]
            label = str(int(cls))
            if names and int(cls) in range(len(names)):
                label = str(names[int(cls)])
            dets.append({
                "label": label,
                "confidence": float(round(conf, 4)),
                "box": [x1, y1, x2, y2]
            })
        elapsed_ms = round((time.time() - t0) * 1000.0, 2)
        return {"ok": True, "detections": dets, "elapsed_ms": elapsed_ms, "meta": {"width": w, "height": h}}, 200
    except Exception as e:
        return {"ok": False, "error": f"inference_failed:{e}"}, 500


# 블루프린트 등록
app.register_blueprint(api)

# 간단 요청 로그 & 라우트 덤프
@app.before_request
def _log_path():
    try:
        print(f"[REQ] {request.method} {request.path}")
    except Exception:
        pass

@app.get("/__routes")
def __routes():
    return {"rules": [str(r) for r in app.url_map.iter_rules()]}

